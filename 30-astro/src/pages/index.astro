---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content="Un trazo en tres dimensiones. Arrastra para explorar; doble clic para volver al encuadre original." />
    <title>30 — natochi</title>
    <link rel="icon" href="data:," />
  </head>
  <body>
    <main>
      <img src={`${base}/reference.png`} width="904" height="883" alt="Gráfica tridimensional de una trayectoria negra, con ejes x, y, z, sobre fondo blanco." />
      <canvas tabindex="0" role="img" aria-label="Gráfica 3D interactiva. Arrastra o usa las flechas para girar. Usa más y menos para zoom. Pulsa Inicio o haz doble clic para restaurar la vista." data-source={`${base}/cloud.bin`}></canvas>
      <p class="sr-only" id="instructions">Arrastra para girar, desplaza para acercar. Doble clic o Inicio para volver a la vista original.</p>
    </main>
    <script>import '../scripts/plot';</script>
  </body>
</html>
<style is:global>
  * { box-sizing: border-box; }
  html, body { margin: 0; width: 100%; height: 100%; background: white; overflow: hidden; }
  main { width: 100%; height: 100%; display: grid; place-items: center; }
  img { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; touch-action: none; cursor: grab; opacity: 0; }
  canvas.ready { opacity: 1; }
  canvas:active { cursor: grabbing; }
  canvas:focus-visible { outline: 1px dotted #888; outline-offset: -5px; }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
</style>
