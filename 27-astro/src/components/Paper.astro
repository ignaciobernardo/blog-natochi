<svg class="paper" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
  <filter id="paper-grain">
    <feTurbulence type="fractalNoise" baseFrequency=".72" numOctaves="3" stitchTiles="stitch" />
    <feColorMatrix type="saturate" values="0" />
  </filter>
  <rect width="100%" height="100%" filter="url(#paper-grain)" opacity=".2" />
</svg>
<style>
  .paper { position: fixed; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; mix-blend-mode: multiply; }
  :global(html) { background: #f3f3ed; color: #24241f; }
</style>
