---
import { authors } from '../data/authors';
import lines from '../data/lines.json';
import Paper from '../components/Paper.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="A tangled mesh of Natochi. Explore each name in the map." />
    <title>A tangled mesh of Natochi</title>
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <Paper />
    <main aria-label="A tangled mesh of Natochi">
      <svg class="map" viewBox="0 0 751 646" xmlns="http://www.w3.org/2000/svg" aria-label="A tangled mesh of Natochi — linked names">
        <g class="connections" aria-hidden="true">
          {lines.map(([x1, y1, x2, y2]) => <line x1={x1} y1={y1} x2={x2} y2={y2} />)}
        </g>
        <g class="names">
          {authors.map(author => (
            <a href={`/27/${author.slug}/`} aria-label={author.name}>
              <text x={author.x} y={author.y}>
                {(author.lines ?? [author.name]).map((line, index) => (
                  <tspan x={author.x} dy={index === 0 ? 0 : 14}>{line}</tspan>
                ))}
              </text>
            </a>
          ))}
        </g>
        <text class="caption" x="43" y="632">A tangled mesh of Natochi</text>
      </svg>
    </main>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; }
  main { min-height: 100svh; display: grid; place-items: center; }
  .map { display: block; width: min(100vw, 116.254svh); height: auto; overflow: visible; }
  .connections { stroke: #33332e; stroke-width: 1.15; stroke-linecap: round; opacity: .92; }
  .names { font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: 400; }
  .names text { fill: #252520; stroke: #f3f3ed; stroke-width: 5px; stroke-linejoin: round; paint-order: stroke fill; }
  .names a { cursor: pointer; }
  .names a:hover text { fill: #000; text-decoration: underline; text-decoration-thickness: 1px; }
  .names a:focus-visible { outline: 1px solid #252520; outline-offset: 4px; }
  .caption { font: 19px Georgia, 'Times New Roman', serif; fill: #24241f; }
</style>
