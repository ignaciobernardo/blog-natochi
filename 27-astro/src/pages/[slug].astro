---
import { authors } from '../data/authors';
export function getStaticPaths() {
  return authors.map(author => ({ params: { slug: author.slug }, props: { author } }));
}
const { author } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{author.name} — A Tangled Mesh of Modernists</title>
    <meta name="description" content={author.text} />
    <link rel="icon" href="/favicon.svg" />
  </head>
  <body>
    <main>
      <a href="/27/">← Volver al mapa</a>
      <h1>{author.name}</h1>
      <p>{author.text}</p>
    </main>
  </body>
</html>
<style>
  :global(html) { color: #24241f; background: #f3f3ed; font-family: Georgia, 'Times New Roman', serif; }
  :global(body) { margin: 0; }
  main { max-width: 560px; margin: 0 auto; padding: clamp(48px, 12vh, 120px) 28px; }
  a { color: inherit; text-underline-offset: 4px; font-size: 15px; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 5px; }
  h1 { margin: 64px 0 28px; font-size: clamp(30px, 6vw, 44px); font-weight: 400; }
  p { font-size: 19px; line-height: 1.75; }
</style>
