---
import PixelTrail from './PixelTrail.astro';
import PaletteSwitch from './PaletteSwitch.astro';

// Provisional copy; replace these props when the landing's identity is defined.
interface Props { brand?: string; titleFirst?: string; titleSecond?: string; description?: string; }
const {
  brand = 'ideas.',
  titleFirst = 'Ideas que',
  titleSecond = 'cobran vida.',
  description = 'Dale forma a eso que todavía no existe.',
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<PixelTrail variant="numbers" background="#1B1B1B" grid={false} preview />

<div class="site-shell">
  <header>
    <details class="menu" data-trail-controls>
      <summary aria-label="Abrir menú"><span></span><span></span></summary>
      <nav aria-label="Navegación principal">
        <a href={base}>Inicio <span>↗</span></a>
        <a href={`${base}numbers`}>Píxeles con peso <span>↗</span></a>
        <a href={`${base}points`}>Versión de puntos <span>↗</span></a>
        <a href={`${base}blocks`}>Bloques originales <span>↗</span></a>
      </nav>
    </details>
    <a class="wordmark" href={base} aria-label={`${brand} Inicio`}>{brand}</a>
  </header>

  <main class="hero">
    <svg class="circuits" viewBox="0 0 1400 850" preserveAspectRatio="none" fill="none" aria-hidden="true">
      <path d="M300 -10 V36 Q300 56 280 56 H82 V490 Q82 520 52 520 H-20" />
      <path d="M328 -10 V56 Q328 84 300 84 H110 V516 Q110 548 78 548 H-20" />
      <path d="M1100 860 V704 Q1100 677 1128 677 H1290 V220 Q1290 192 1318 192 H1420" />
      <path d="M1128 860 V726 Q1128 705 1150 705 H1318 V245 Q1318 220 1344 220 H1420" />
    </svg>

    <div class="hero-copy">
      <p class="eyebrow">TODO EMPIEZA CON UNA IDEA</p>
      <h1><span>{titleFirst}</span><br /><span>{titleSecond}</span></h1>
      <p class="description">{description}</p>
      <a class="explore" href={`${base}numbers`}>Explorar <span aria-hidden="true">↗</span></a>
      <div class="palette-control"><PaletteSwitch /></div>
    </div>

    <div class="hero-bottom">
      <span>UN PEQUEÑO MOVIMIENTO.<br />INFINITAS POSIBILIDADES.</span>
      <span class="interaction-hint">Mueve el cursor · haz clic</span>
      <span class="index">01 — INICIO</span>
    </div>
  </main>
</div>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.menu');
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  document.addEventListener('click', event => {
    if (menu?.open && !menu.contains(event.target as Node)) menu.open = false;
  });
</script>

<style>
  .site-shell { position: relative; z-index: 1; margin: 8px; border: 1px solid #303030; border-radius: 12px; min-height: calc(100svh - 16px); pointer-events: none; }
  header { position: relative; z-index: 3; height: 70px; border-bottom: 1px solid #303030; display: flex; align-items: center; justify-content: space-between; padding: 0 28px; }
  .wordmark { pointer-events: auto; color: #fafaf7; font-size: 23px; font-weight: 600; letter-spacing: -1.3px; text-decoration: none; }
  .menu { pointer-events: auto; }
  summary { list-style: none; cursor: pointer; width: 36px; height: 36px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: 5px; }
  summary::-webkit-details-marker { display: none; }
  summary span { height: 4px; width: 22px; border-radius: 2px; background: #fafaf7; }
  summary span:last-child { width: 16px; height: 3px; }
  nav { position: absolute; top: 60px; left: 20px; padding: 8px; width: 235px; border: 1px solid #3d3d39; background: #232323; border-radius: 10px; box-shadow: 0 16px 32px #00000030; }
  nav a { display: flex; justify-content: space-between; padding: 13px 12px; border-radius: 5px; color: #eeeae3; text-decoration: none; font-size: 13px; }
  nav a:hover { background: #333330; }
  nav a span { color: #95958a; }
  .hero { position: relative; min-height: max(680px, calc(100svh - 88px)); overflow: hidden; border-radius: 0 0 12px 12px; }
  .circuits { position: absolute; inset: 0; width: 100%; height: 100%; stroke: #333333; stroke-width: 1.3; opacity: 0.7; }
  .hero-copy { position: relative; text-align: center; padding: clamp(95px, 14vh, 175px) 24px 230px; }
  .eyebrow { font: 10px ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 1.8px; color: #a3a399; margin: 0 0 30px; }
  h1 { margin: 0; font-size: clamp(58px, 7.8vw, 112px); line-height: 1.21; font-weight: 500; letter-spacing: -0.065em; }
  h1 span { display: inline-block; background: #080808; color: #fafaf7; padding: 0 0.2em 0.075em 0.14em; border-radius: 7px; line-height: 1.05; }
  .description { font-size: 15px; color: #a3a399; margin: 26px 0 21px; }
  .explore { pointer-events: auto; display: inline-flex; align-items: center; gap: 32px; color: #eeeae3; font-size: 12px; text-decoration: none; border-bottom: 1px solid #66665f; padding: 0 0 8px; }
  .explore:hover { border-color: #fafaf7; }
  .palette-control { margin-top: 20px; }
  .hero-bottom { position: absolute; bottom: 26px; left: 28px; right: 28px; display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; color: #929288; font: 9px/1.7 ui-monospace, SFMono-Regular, Menlo, monospace; letter-spacing: 0.5px; }
  .interaction-hint { letter-spacing: 0; font-size: 10px; }
  @media (max-width: 600px) {
    .site-shell { margin: 5px; min-height: calc(100svh - 10px); border-radius: 9px; }
    header { height: 50px; padding: 0 16px; }
    .wordmark { font-size: 19px; }
    .hero { min-height: max(630px, calc(100svh - 62px)); }
    .hero-copy { padding: 115px 15px 240px; }
    .eyebrow { font-size: 8px; letter-spacing: 1.3px; margin-bottom: 27px; }
    h1 { font-size: clamp(40px, 11.5vw, 67px); }
    h1 span { border-radius: 5px; }
    .description { font-size: 12px; margin: 22px 0; }
    .hero-bottom { bottom: 20px; left: 16px; right: 16px; font-size: 8px; }
    .interaction-hint { display: none; }
    nav { top: 45px; left: 10px; }
  }
</style>
