<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"/><meta name="theme-color" content="#111"/><title>Arquideas</title><style>
@font-face{font-family:Fell;src:url('/33/im-fell-english.ttf')}@font-face{font-family:Fraktur;src:url('/33/unifrakturmaguntia.ttf')}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#0d0c0c;color:#dcd8d4;-webkit-font-smoothing:antialiased}.dark-page{position:absolute;left:50%;top:50%;width:736px;height:441px;transform:translate(-50%,-50%) scale(var(--dark-fit,1));transform-origin:center;background:#0d0c0c;overflow:hidden}.dark-page:after{content:"";position:absolute;inset:0;pointer-events:none;opacity:.13;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 140 140' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.2'/%3E%3C/svg%3E")}.desktop{display:block}.mobile{display:none}.arc{position:absolute;left:272px;top:14px;width:190px;height:108px;fill:#dedbd8}.arc text{font:18px 'Brush Script MT',cursive;letter-spacing:1px}.flower{position:absolute;left:319px;top:63px;width:100px;height:62px;fill:none;stroke:#dedbd8;stroke-width:1.1}.director,.copyright{position:absolute;top:123px;font:25px/.9 Fraktur,Georgia,serif;text-align:center}.director{left:40px;width:124px;transform:rotate(-5deg)}.copyright{right:31px;width:143px;transform:rotate(3deg)}.main-title{position:absolute;left:225px;top:116px;width:288px;text-align:center;font:italic 47px/1 'Snell Roundhand','Brush Script MT',cursive;white-space:nowrap;letter-spacing:-2px;transform:skew(-8deg)}.quote{position:absolute;top:125px;font:35px Georgia,serif;line-height:1}.quote.first{left:224px}.quote.last{left:490px}.dot{position:absolute;top:149px;width:7px;height:7px;border-radius:50%;background:#ddd8d4}.dot.a{left:185px}.dot.b{left:538px}.credits{position:absolute;top:182px;display:grid;grid-template-columns:max-content 1fr;column-gap:11px;font:600 6.4px/7.25px Arial,Helvetica,sans-serif;text-transform:uppercase;color:#e0dcda}.credits .role{text-align:right}.credits .name{white-space:nowrap}.credits.left{left:66px;line-height:11.1px}.credits.right{left:485px;line-height:10.3px;grid-template-columns:50px 1fr}.center{position:absolute;top:185px;left:285px;width:170px;height:232px;display:flex;align-items:center;justify-content:space-between}.vine{width:38px;height:232px;fill:none;stroke:#d6d2cf;stroke-width:1.4;stroke-linecap:round}.letters{width:72px;height:232px;display:flex;flex-direction:column;align-items:center;justify-content:space-between;font:51px/1 Georgia,serif}.letters span:first-child,.letters span:nth-child(3){font-family:Fraktur}.vine.flipped{transform:scaleX(-1)}.mobile .beast{position:absolute;left:101px;top:20px;width:306px;height:245px;object-fit:contain}.mobile .caption{position:absolute;top:271px;width:100%;text-align:center;font:12px Fell,Georgia,serif;color:#aaa4a0}.mobile h1{position:absolute;left:45px;right:45px;top:320px;margin:0;text-align:center;font:27px/1.07 Fraktur,Georgia,serif;font-weight:400;color:#d4d0cd}.mobile .description{position:absolute;left:55px;right:46px;top:391px;margin:0;font:18px/1.25 Fell,Georgia,serif;text-align:justify;letter-spacing:1px;color:#d2ceca}.mobile .smallcaps{font-variant:small-caps;letter-spacing:2px}.mobile .ending{position:absolute;left:55px;right:51px;top:529px;margin:0;font:18px/1.35 Fell,Georgia,serif;text-align:justify;letter-spacing:.7px;color:#d2ceca;text-indent:18px}@media(max-width:620px){.dark-page{width:500px;height:646px;background:#0d0c0c}.desktop{display:none}.mobile{display:block}}

.desktop::before{content:"";position:absolute;left:0;top:0;width:736px;height:180px;background:url('/33/credits-header.png') no-repeat;z-index:1}
.desktop::after{content:"";position:absolute;left:276px;top:178px;width:184px;height:245px;background:url('/33/credits-center.png') no-repeat;z-index:1}
.desktop .arc,.desktop .flower,.desktop .director,.desktop .copyright,.desktop .main-title,.desktop .quote,.desktop .dot,.desktop .center{display:none}
.desktop .credits{z-index:2;text-shadow:0 0 .18px #ddd}
@media(max-width:620px){html,body{background:#0d0c0c}.dark-page:after,.desktop::before,.desktop::after{display:none}}
</style></head><body><main class="dark-page"><section class="desktop" aria-label="Arquideas film credits"><svg class="arc" viewBox="0 0 190 108" aria-hidden="true"><defs><path id="arcpath" d="M 7 94 C 34 11, 149 8, 183 94"/></defs><text><textPath href="#arcpath" startOffset="50%" text-anchor="middle">music is all mind's eye, why</textPath></text></svg><svg class="flower" viewBox="0 0 100 62" aria-hidden="true"><path d="M50 48C37 41 28 37 19 34M50 48c8-9 13-13 19-16M49 47c-4-11-5-20-2-28M47 20c-7-7-1-15 5-18 6 10 5 15-5 18Zm0 1C34 16 28 19 22 27c9 4 17 3 25-6Zm1 0c8-10 15-10 25-4-6 9-14 10-25 4Zm0 2c-7 2-10 10-9 17 8-3 12-8 9-17Zm1 0c11 0 18 6 21 15-9 0-16-4-21-15ZM19 34C9 28 4 30 1 37c5 5 11 4 18-3Zm50-2c8-8 16-6 19 1-7 5-12 5-19-1Z"/></svg><div class="director">Directed by<br/>Sipa</div><span class="quote first">“</span><div class="main-title">Arquideas</div><span class="quote last">”</span><div class="copyright">© 2024 Seffen<br/>Remo</div><i class="dot a"></i><i class="dot b"></i><div class="credits left">{left.map(([a,b])=><><span class="role">{a}</span><span class="name">{b}</span></>)}</div><div class="center" aria-hidden="true"><svg class="vine" viewBox="0 0 38 232"><path d="M25 230C18 195 17 164 14 128 12 89 14 44 21 2M17 87C4 75 3 57 6 40m8 95c12-4 19-15 20-31m-17 60C6 158 4 145 6 134m14 57C7 185 4 174 6 165M15 48C26 40 30 26 29 15M7 42C1 35 2 27 4 22m3 23C2 45 1 49 3 54m16 4c9-4 14-11 16-20m-20 20C5 55 4 47 4 42m10 62c-6 3-8-1-10-5m13 19c8-1 12-8 14-14m-15 45c-8-3-11-11-11-19m16 34c8-2 13-9 14-18m-17 39c-7 1-13 9-14 17m15-13c7 5 11 5 16 1m-13 16c-9 0-12 7-11 13m13-9c6 0 9 6 9 11"/><circle cx="14" cy="117" r="2.5" fill="#d6d2cf"/></svg><div class="letters"><span>R</span><span>A</span><span>c</span><span>I</span></div><svg class="vine flipped" viewBox="0 0 38 232"><path d="M25 230C18 195 17 164 14 128 12 89 14 44 21 2M17 87C4 75 3 57 6 40m8 95c12-4 19-15 20-31m-17 60C6 158 4 145 6 134m14 57C7 185 4 174 6 165M15 48C26 40 30 26 29 15M7 42C1 35 2 27 4 22m3 23C2 45 1 49 3 54m16 4c9-4 14-11 16-20m-20 20C5 55 4 47 4 42m10 62c-6 3-8-1-10-5m13 19c8-1 12-8 14-14m-15 45c-8-3-11-11-11-19m16 34c8-2 13-9 14-18m-17 39c-7 1-13 9-14 17m15-13c7 5 11 5 16 1m-13 16c-9 0-12 7-11 13m13-9c6 0 9 6 9 11"/><circle cx="14" cy="117" r="2.5" fill="#d6d2cf"/></svg></div><div class="credits right">{right.map(([a,b])=><><span class="role">{a}</span><span class="name">{b}</span></>)}</div></section><section class="mobile" aria-label="Mantygre, Montegre or Manticora Satyral"><img class="beast" src="/33/mantygre.png" alt="Antique line drawing of a horned heraldic mantygre"/><div class="caption">Mantygre—Satyral.</div><h1>Mantiger, Montegre or Manticora<br/>Satyral</h1><p class="description">A <span class="smallcaps">chimerical</span> creature of mediæval invention, having the body of an heraldic tiger with mane, and the head of an old man with long spiral horns. Some heraldic authorities make the horns more like those of an ox, and the feet like a dragon’s.</p><p class="ending"><em>The Satyral</em> is apparently identical with the man-tiger.</p></section></main><LightPage base="/33"/><script is:inline>function fit(){let m=matchMedia('(max-width:620px)').matches;document.documentElement.style.setProperty('--dark-fit',Math.min(innerWidth/(m?500:736),innerHeight/(m?646:441)));document.documentElement.style.setProperty('--paper-fit',Math.min(innerWidth/816,innerHeight/1200));}addEventListener('resize',fit,{passive:true});fit();</script></body></html>
